          "name": "Creer une commande",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const serviceId = pm.environment.get('nouveauServiceId');",
                  "if (!serviceId) throw new Error('Service ID manquant - lance d abord la creation du service');",
                  "",
                  "const generateUUID = () => {",
                  "    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "        const r = Math.random() * 16 | 0;",
                  "        const v = c === 'x' ? r : (r & 0x3 | 0x8);",
                  "        return v.toString(16);",
                  "    });",
                  "};",
                  "",
                  "const idempotencyKey = generateUUID();",
                  "pm.environment.set('current_idempotency_key', idempotencyKey);",
                  "console.log('Idempotency Key: ' + idempotencyKey);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Commande creee', () => pm.response.to.have.status(201));",
                  "const response = pm.response.json();",
                  "if (response.id) {",
                  "    pm.environment.set('order_id', response.id);",
                  "    console.log('Commande creee - ID: ' + response.id);",
                  "}",
                  "if (response.items && response.items[0] && response.items[0].id) {",
                  "    pm.environment.set('item_id', response.items[0].id);",
                  "    console.log('Order item ID: ' + response.items[0].id);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
